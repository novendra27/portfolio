---
import type { SupportedLanguage } from '@/i18n/ui';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLanguage;
}

const {
  title = 'Adi Novendra Putra, S.Kom. | Fullstack Developer & Software Engineer',
  description = 'Portfolio rekayasa perangkat lunak Adi Novendra Putra. Spesialisasi Java Spring Boot, Apache Kafka, Go, Laravel, React, Next.js, dan arsitektur sistem performa tinggi.',
  lang = 'id',
} = Astro.props;

const siteUrl = 'https://novendra.dev';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const alternateIdUrl = new URL('/', siteUrl).toString();
const alternateEnUrl = new URL('/en/', siteUrl).toString();
const ogImageUrl = new URL('/images/avatar.webp', siteUrl).toString();
const ogLocale = lang === 'id' ? 'id_ID' : 'en_US';
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Adi Novendra Putra" />
    <meta name="theme-color" content="#090d16" />

    <!-- Canonical & Bilingual Hreflang SEO -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="id" href={alternateIdUrl} />
    <link rel="alternate" hreflang="en" href={alternateEnUrl} />
    <link rel="alternate" hreflang="x-default" href={alternateIdUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Adi Novendra Putra Portfolio" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:creator" content="@novendra27" />

    <!-- Schema.org JSON-LD (GEO, AEO, Traditional SEO) -->
    <JsonLd lang={lang} canonicalUrl={canonicalUrl} />
  </head>
  <body class="min-h-screen bg-canvas text-text-contrast antialiased selection:bg-accent-primary/20 selection:text-accent-primary-light flex flex-col">
    <!-- Subtle Blueprint Grid Layer -->
    <div class="fixed inset-0 bg-grid pointer-events-none z-0 opacity-80" aria-hidden="true"></div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <Header lang={lang} />
      <div class="flex-1">
        <slot />
      </div>
      <Footer lang={lang} />
    </div>
  </body>
</html>
