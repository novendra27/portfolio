---
import type { SupportedLanguage } from '@/i18n/ui';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BottomNav from '@/components/BottomNav.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLanguage;
}

const {
  title = 'Adi Novendra Putra, S.Kom. | Fullstack Developer & Software Engineer',
  description = 'Portfolio rekayasa perangkat lunak Adi Novendra Putra. Spesialisasi Java Spring Boot, Apache Kafka, Go, Laravel, React, Next.js, dan arsitektur sistem performa tinggi.',
  lang = 'id',
} = Astro.props;

const siteUrl = 'https://adino.my.id';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const alternateIdUrl = new URL('/', siteUrl).toString();
const alternateEnUrl = new URL('/en/', siteUrl).toString();
const ogImageUrl = new URL('/images/avatar.webp', siteUrl).toString();
const ogLocale = lang === 'id' ? 'id_ID' : 'en_US';
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Adi Novendra Putra" />
    <meta name="theme-color" content="#090d16" />

    <!-- Canonical & Bilingual Hreflang SEO -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="id" href={alternateIdUrl} />
    <link rel="alternate" hreflang="en" href={alternateEnUrl} />
    <link rel="alternate" hreflang="x-default" href={alternateIdUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Adi Novendra Putra Portfolio" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:creator" content="@novendra27" />

    <!-- Schema.org JSON-LD (GEO, AEO, Traditional SEO) -->
    <JsonLd lang={lang} canonicalUrl={canonicalUrl} />
  </head>
  <body class="min-h-screen bg-canvas text-text-contrast antialiased selection:bg-accent-primary/20 selection:text-accent-primary-light flex flex-col relative overflow-x-clip">
    <!-- Subtle Blueprint Grid Layer -->
    <div class="fixed inset-0 bg-grid pointer-events-none z-0 opacity-80" aria-hidden="true"></div>

    <!-- Outer Gutter Hatching on screens >= 1280px (xl) -->
    <div
      class="hidden xl:block fixed inset-y-0 left-0 w-[calc((100vw-72rem)/2)] bg-hatch-45 pointer-events-none z-0 border-r border-border-architectural opacity-70"
      aria-hidden="true"
    ></div>
    <div
      class="hidden xl:block fixed inset-y-0 right-0 w-[calc((100vw-72rem)/2)] bg-hatch-45 pointer-events-none z-0 border-l border-border-architectural opacity-70"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 flex flex-col min-h-screen w-full pb-20 md:pb-0">
      <Header lang={lang} />
      <div class="flex-1 w-full max-w-6xl mx-auto xl:border-x xl:border-border-architectural bg-canvas/30">
        <!-- Architectural Telemetry Strip -->
        <div class="hidden sm:flex items-center justify-between px-4 sm:px-6 py-1.5 border-b border-border-architectural bg-surface-card/60 font-mono text-[10px] text-text-dim select-none">
          <div class="flex items-center gap-3">
            <span class="text-accent-primary font-bold">STACK: ASTRO v5 // TAILWIND v3</span>
            <span class="text-border-architectural">|</span>
            <span>ARCHITECTURE: ZERO-JS SSG</span>
            <span class="text-border-architectural">|</span>
            <span>RUNTIME: EDGE DEPLOYED</span>
          </div>
          <div class="flex items-center gap-3">
            <span>PERFORMANCE: 100/100</span>
            <span class="text-border-architectural">|</span>
            <span class="text-accent-primary font-medium">SYS_STATUS: OPTIMAL</span>
          </div>
        </div>
        <slot />
      </div>
      <Footer lang={lang} />
      <BottomNav lang={lang} />
    </div>

    <!-- Architectural Motion & Scroll Reveal Engine (Native & Zero-Dependency) -->
    <script is:inline>
      (() => {
        const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealElements = document.querySelectorAll('.arch-reveal');

        if (isReducedMotion) {
          revealElements.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  observer.unobserve(entry.target);
                }
              });
            },
            {
              rootMargin: '0px 0px -60px 0px',
              threshold: 0.08,
            }
          );

          revealElements.forEach((el) => observer.observe(el));
        } else {
          revealElements.forEach((el) => el.classList.add('is-revealed'));
        }
      })();
    </script>

    <!-- Unified Architectural Scrollspy Engine (Single Source of Truth) -->
    <script>
      function initUnifiedScrollspy() {
        const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav-link');
        const desktopContactBtn = document.querySelector<HTMLAnchorElement>('.desktop-nav-contact');
        const bottomLinks = document.querySelectorAll<HTMLAnchorElement>('.bottom-nav-link');

        const SECTION_IDS = [
          'hero',
          'architecture',
          'projects',
          'tech-stack',
          'experience',
          'pricing',
          'publications',
          'contact',
        ];

        const SECTION_TO_HUB: Record<string, string> = {
          'hero': 'hero',
          'architecture': 'architecture',
          'projects': 'projects',
          'tech-stack': 'projects',
          'experience': 'experience',
          'pricing': 'experience',
          'publications': 'experience',
          'contact': 'contact',
        };

        let currentActiveSection = '';
        let ticking = false;

        function updateActiveState() {
          const scrollY = window.scrollY;
          const scrollBottom = window.innerHeight + scrollY;
          const docHeight = document.documentElement.scrollHeight;

          let newActiveId = 'hero';

          if (scrollBottom >= docHeight - 80) {
            newActiveId = 'contact';
          } else if (scrollY > 100) {
            const ACTIVATION_OFFSET = 150;
            for (let i = SECTION_IDS.length - 1; i >= 0; i--) {
              const id = SECTION_IDS[i];
              const el = document.getElementById(id);
              if (el) {
                const top = el.offsetTop;
                if (scrollY >= top - ACTIVATION_OFFSET) {
                  newActiveId = id;
                  break;
                }
              }
            }
          }

          if (newActiveId === currentActiveSection) return;
          currentActiveSection = newActiveId;

          // 1. Update Desktop Header Navigation
          desktopLinks.forEach((link) => {
            const target = link.getAttribute('data-nav-href');
            const isActive = target === `#${currentActiveSection}`;
            if (isActive) {
              link.classList.add('text-text-contrast', 'underline', 'font-semibold');
              link.classList.remove('text-text-muted');
            } else {
              link.classList.remove('text-text-contrast', 'underline', 'font-semibold');
              link.classList.add('text-text-muted');
            }
          });

          if (desktopContactBtn) {
            if (currentActiveSection === 'contact') {
              desktopContactBtn.classList.add('border-accent-primary/60', 'bg-surface-elevated', 'text-accent-primary');
              desktopContactBtn.classList.remove('border-border-architectural', 'bg-surface-card', 'text-text-contrast');
            } else {
              desktopContactBtn.classList.remove('border-accent-primary/60', 'bg-surface-elevated', 'text-accent-primary');
              desktopContactBtn.classList.add('border-border-architectural', 'bg-surface-card', 'text-text-contrast');
            }
          }

          // 2. Update Mobile Bottom Navigation
          const targetHub = SECTION_TO_HUB[currentActiveSection] || 'hero';

          bottomLinks.forEach((link) => {
            const hub = link.getAttribute('data-bottom-hub');
            const labelEl = link.querySelector<HTMLElement>('.bottom-nav-label');
            const dotEl = link.querySelector<HTMLElement>('.bottom-nav-dot');
            const defaultLabel = link.getAttribute('data-default-label') || '';
            const subLabelsRaw = link.getAttribute('data-sublabels') || '{}';

            let subLabels: Record<string, string> = {};
            try {
              subLabels = JSON.parse(subLabelsRaw);
            } catch {
              // fallback
            }

            const isActiveHub = hub === targetHub;

            if (isActiveHub) {
              link.classList.add('text-accent-primary', 'bg-surface-elevated', 'font-semibold', 'active-bottom-nav');
              link.classList.remove('text-text-muted');

              if (labelEl) {
                const contextualLabel = subLabels[currentActiveSection] || defaultLabel;
                labelEl.textContent = contextualLabel;
              }

              if (dotEl) {
                const isSubSection = currentActiveSection !== hub;
                if (isSubSection) {
                  dotEl.classList.remove('opacity-0');
                  dotEl.classList.add('opacity-100');
                } else {
                  dotEl.classList.remove('opacity-100');
                  dotEl.classList.add('opacity-0');
                }
              }
            } else {
              link.classList.remove('text-accent-primary', 'bg-surface-elevated', 'font-semibold', 'active-bottom-nav');
              link.classList.add('text-text-muted');

              if (labelEl) {
                labelEl.textContent = defaultLabel;
              }
              if (dotEl) {
                dotEl.classList.remove('opacity-100');
                dotEl.classList.add('opacity-0');
              }
            }
          });
        }

        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              updateActiveState();
              ticking = false;
            });
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });

        // Defer initial calculation to eliminate synchronous forced layout reflow during initial page render
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(() => updateActiveState(), { timeout: 200 });
        } else {
          setTimeout(updateActiveState, 150);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUnifiedScrollspy);
      } else {
        initUnifiedScrollspy();
      }
    </script>
  </body>
</html>
