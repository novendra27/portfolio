---
import { useTranslations, type SupportedLanguage } from '@/i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { href: '#architecture', label: t('nav.architecture') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#tech-stack', label: t('nav.techStack') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#pricing', label: t('nav.pricing') },
  { href: '#publications', label: t('nav.publications') },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-border-architectural bg-canvas/80 backdrop-blur-md transition-all arch-bleed-line-bottom"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Brand / Architectural Monogram -->
    <a
      href={lang === 'en' ? '/en/' : '/'}
      class="group flex items-center gap-2 font-mono text-xs tracking-tight text-text-contrast hover:text-accent-primary transition-colors"
    >
      <span class="inline-flex items-center justify-center w-6 h-6 rounded border border-border-architectural bg-surface-card text-accent-primary font-bold group-hover:border-accent-primary/40 shadow-tactile-surface transition-colors">
        A
      </span>
      <span class="font-semibold hidden sm:inline">ADI NOVENDRA</span>
      <span class="text-text-dim text-[11px] hidden md:inline">// SOFTWARE ENGINEER</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-mono" aria-label="Main Navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-text-muted hover:text-text-contrast transition-colors py-1 hover:underline underline-offset-4 decoration-accent-primary/50"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right Controls: Language Switcher & Contact Button -->
    <div class="flex items-center gap-3">
      <LanguageSwitcher lang={lang} />

      <a
        href="#contact"
        class="hidden sm:inline-flex items-center px-3 py-1.5 rounded-control text-xs font-mono font-medium border border-border-architectural bg-surface-card hover:bg-surface-elevated hover:border-border-architectural-hover text-text-contrast shadow-tactile-surface transition-all active:translate-y-px"
      >
        {t('nav.contact')}
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-1.5 rounded border border-border-architectural text-text-muted hover:text-text-contrast"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-border-architectural bg-surface-card/95 backdrop-blur-md px-4 py-4 space-y-3"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block font-mono text-xs text-text-muted hover:text-text-contrast py-1 mobile-link"
      >
        {item.label}
      </a>
    ))}
    <a
      href="#contact"
      class="block font-mono text-xs text-accent-primary py-1 mobile-link"
    >
      {t('nav.contact')}
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
    });

    links.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
