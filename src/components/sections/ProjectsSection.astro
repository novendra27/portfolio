---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projectRepository, categoryRepository } from '@/lib/repositories';
import { useTranslations, type SupportedLanguage } from '@/i18n/ui';
import SectionHeading from '../SectionHeading.astro';
import ArchitecturalTabs from '../ArchitecturalTabs.astro';
import Badge from '../Badge.astro';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await projectRepository.getAllWithRelations();
const allCategories = await categoryRepository.getAll();

const projectImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/projects/*.webp',
  { eager: true }
);

function getProjectImage(thumbnail: string | null): ImageMetadata | null {
  if (!thumbnail) return null;
  const filename = thumbnail.split('/').pop();
  if (!filename) return null;
  const key = `/src/assets/images/projects/${filename}`;
  return projectImages[key]?.default ?? null;
}

// Compute categories with active projects for dynamic filtering
const activeCategories = allCategories
  .map((cat) => {
    const count = projects.filter((p) => p.category_ids.includes(cat.id)).length;
    return { ...cat, count };
  })
  .filter((c) => c.count > 0);
---

<section id="projects" class="py-16 md:py-24 border-b border-border-architectural arch-bleed-line-bottom">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <SectionHeading
      index={t('section.projects.index')}
      title={t('section.projects.title')}
      subtitle={lang === 'id'
        ? 'Koleksi 9 studi kasus rekayasa perangkat lunak nyata dari sistem backend event-driven, optimasi kecerdasan buatan, hingga platform penagihan utilitas desa.'
        : 'Curated 9 real-world engineering case studies spanning event-driven streaming, AI optimization algorithms, and municipal utility billing systems.'}
    />

    <!-- Unified Master-Detail Blueprint Showcase Console -->
    <div class="arch-slice arch-reveal">
      <div class="border-x border-border-architectural bg-canvas w-full max-w-full overflow-hidden" id="project-showcase-console">
        
        <!-- ==================================================================== -->
        <!-- DESKTOP TIER 1: Blueprint Spec, Category Filter Bar & Navigation (md+) -->
        <!-- ==================================================================== -->
        <div class="hidden md:flex px-4 sm:px-6 py-2 border-b border-border-architectural bg-surface-card/70 items-center justify-between gap-4 font-mono text-[10px] select-none">
          <!-- Left: Bounded Filter Control Chamber -->
          <div class="flex items-center gap-2 min-w-0 flex-1 overflow-hidden">
            <span class="text-accent-primary font-bold hidden xl:inline shrink-0">// SPEC_02:SHOWCASE</span>
            <span class="text-border-architectural hidden xl:inline shrink-0">|</span>
            <span class="text-accent-primary font-bold shrink-0">// FILTER:</span>
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 min-w-0 flex-1" id="desktop-category-filters">
              <button
                type="button"
                data-cat-filter="all"
                class="cat-filter-btn px-2.5 py-1 rounded border border-accent-primary bg-surface-elevated text-accent-primary font-semibold transition-all shrink-0 cursor-pointer shadow-tactile-primary touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary active:scale-[0.98]"
              >
                ALL ({projects.length})
              </button>
              {activeCategories.map((cat) => (
                <button
                  type="button"
                  data-cat-filter={cat.id}
                  class="cat-filter-btn px-2.5 py-1 rounded border border-border-architectural bg-surface-card text-text-muted hover:text-text-contrast hover:border-accent-primary/40 transition-all shrink-0 cursor-pointer touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary active:scale-[0.98]"
                >
                  {cat.name.split('&')[0].trim().toUpperCase()} ({cat.count})
                </button>
              ))}
            </div>
          </div>

          <!-- Right: Protected Index Counter & Sequential Controls Chamber -->
          <div class="flex items-center gap-3 shrink-0 ml-auto pl-3.5 border-l border-border-architectural">
            <div class="flex items-center gap-1.5">
              <span class="text-text-dim">INDEX:</span>
              <span class="text-accent-primary font-bold tabular-nums desktop-index-counter">
                01 / {String(projects.length).padStart(2, '0')}
              </span>
            </div>
            <span class="text-border-architectural">|</span>
            <div class="flex items-center gap-1">
              <button
                type="button"
                aria-label="Previous project"
                class="btn-prev-proj px-2.5 py-1 rounded border border-border-architectural bg-surface-card hover:bg-surface-elevated text-text-muted hover:text-text-contrast transition-colors active:translate-y-px text-[10px] cursor-pointer touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary"
              >
                &lt; PREV
              </button>
              <button
                type="button"
                aria-label="Next project"
                class="btn-next-proj px-2.5 py-1 rounded border border-border-architectural bg-surface-card hover:bg-surface-elevated text-text-muted hover:text-text-contrast transition-colors active:translate-y-px text-[10px] cursor-pointer touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary"
              >
                NEXT &gt;
              </button>
            </div>
          </div>
        </div>

        <!-- ==================================================================== -->
        <!-- DESKTOP TIER 2: Horizontal Segmented Project Selector Ribbon (md+)   -->
        <!-- ==================================================================== -->
        <div class="hidden md:block border-b border-border-architectural bg-canvas/90 overflow-x-auto arch-scrollbar scroll-smooth relative" id="project-ribbon-container">
          <div class="flex items-stretch min-w-max divide-x divide-border-architectural font-mono text-xs" role="tablist" aria-label="Project Case Studies">
            {projects.map((proj, idx) => (
              <button
                type="button"
                role="tab"
                id={`tab-${proj.id}`}
                aria-controls={`panel-${proj.id}`}
                aria-selected={idx === 0 ? 'true' : 'false'}
                data-project-id={proj.id}
                data-project-idx={idx}
                data-slug={proj.slug}
                data-categories={proj.category_ids.join(' ')}
                class:list={[
                  'project-selector-tab flex items-center gap-2.5 px-4 sm:px-5 py-3 text-left transition-all shrink-0 cursor-pointer select-none touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary',
                  idx === 0
                    ? 'active-tab bg-surface-elevated text-text-contrast font-semibold border-b-2 border-accent-primary shadow-tactile-primary'
                    : 'bg-surface-card/40 text-text-muted hover:text-text-contrast hover:bg-surface-card/70 border-b-2 border-transparent',
                ]}
              >
                <span class="text-[10px] text-accent-primary font-bold">[0{idx + 1}]</span>
                <span class="truncate max-w-[150px] sm:max-w-[210px] text-xs">
                  {proj.title.split('(')[0].trim()}
                </span>
              </button>
            ))}
          </div>
        </div>

        <!-- ==================================================================== -->
        <!-- MOBILE TIER 1: Category Filter Bar (Smooth touch swipe, no scrollbar) -->
        <!-- ==================================================================== -->
        <div class="md:hidden border-b border-border-architectural bg-surface-card/80 px-3 py-2.5 select-none">
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar font-mono text-[10px]">
            <span class="text-accent-primary font-bold shrink-0 mr-1">// FILTER:</span>
            <button
              type="button"
              data-cat-filter="all"
              class="cat-filter-btn px-3 py-1.5 rounded border border-accent-primary bg-surface-elevated text-accent-primary font-semibold transition-all shrink-0 cursor-pointer shadow-tactile-primary touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary active:scale-[0.98]"
            >
              ALL ({projects.length})
            </button>
            {activeCategories.map((cat) => (
              <button
                type="button"
                data-cat-filter={cat.id}
                class="cat-filter-btn px-2.5 py-1.5 rounded border border-border-architectural bg-surface-card text-text-muted hover:text-text-contrast transition-all shrink-0 cursor-pointer touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary active:scale-[0.98]"
              >
                {cat.name.split('&')[0].trim().toUpperCase()} ({cat.count})
              </button>
            ))}
          </div>
        </div>

        <!-- ==================================================================== -->
        <!-- MOBILE TIER 2: Status Index Counter & Sequential Controls (< md)     -->
        <!-- ==================================================================== -->
        <div class="md:hidden border-b border-border-architectural bg-surface-card/50 px-3 py-2 flex items-center justify-between font-mono text-xs select-none">
          <div class="flex items-center gap-2">
            <span class="text-text-dim text-[10px]">// SPEC_02</span>
            <span class="text-border-architectural">|</span>
            <span class="text-accent-primary font-bold text-xs tabular-nums mobile-index-counter">
              01 / {String(projects.length).padStart(2, '0')}
            </span>
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              aria-label="Previous project"
              class="btn-prev-proj px-3.5 py-2 rounded border border-border-architectural bg-surface-card hover:bg-surface-elevated text-text-muted hover:text-text-contrast transition-colors active:translate-y-px text-xs font-mono font-medium cursor-pointer shadow-tactile-surface touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary min-h-[38px] inline-flex items-center justify-center"
            >
              &lt; PREV
            </button>
            <button
              type="button"
              aria-label="Next project"
              class="btn-next-proj px-3.5 py-2 rounded border border-border-architectural bg-surface-card hover:bg-surface-elevated text-text-muted hover:text-text-contrast transition-colors active:translate-y-px text-xs font-mono font-medium cursor-pointer shadow-tactile-surface touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary min-h-[38px] inline-flex items-center justify-center"
            >
              NEXT &gt;
            </button>
          </div>
        </div>

        <!-- ==================================================================== -->
        <!-- MOBILE TIER 3: Number-Only Coordinate Matrix Keypad (1-Tap Access)   -->
        <!-- ==================================================================== -->
        <div class="md:hidden border-b border-border-architectural bg-canvas/90 overflow-x-auto no-scrollbar scroll-smooth select-none w-full max-w-full" id="mobile-project-ribbon-container">
          <div class="flex items-stretch min-w-max divide-x divide-border-architectural font-mono text-xs" role="tablist" aria-label="Mobile Project Case Studies">
            {projects.map((proj, idx) => (
              <button
                type="button"
                role="tab"
                data-project-idx={idx}
                data-categories={proj.category_ids.join(' ')}
                aria-label={`Project 0${idx + 1}: ${proj.title}`}
                class:list={[
                  'mobile-keypad-btn flex items-center justify-center min-w-[50px] h-11 px-3 transition-all cursor-pointer font-bold touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary shrink-0',
                  idx === 0
                    ? 'active-tab bg-surface-elevated text-accent-primary border-b-2 border-accent-primary shadow-tactile-primary'
                    : 'bg-surface-card/40 text-text-dim hover:text-text-contrast hover:bg-surface-card border-b-2 border-transparent',
                ]}
              >
                <span class="text-xs tabular-nums tracking-wider">{String(idx + 1).padStart(2, '0')}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- ==================================================================== -->
        <!-- TIER 4: Unified Showcase Panels Container (Pre-rendered for SEO/LLM) -->
        <!-- ==================================================================== -->
        <div class="relative bg-canvas min-h-[500px]" id="project-panels-wrapper">
          {projects.map((proj, idx) => (
            <div
              id={`panel-${proj.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${proj.id}`}
              data-project-id={proj.id}
              data-project-idx={idx}
              data-categories={proj.category_ids.join(' ')}
              class:list={[
                'project-showcase-panel transition-opacity duration-200',
                idx === 0 ? 'block' : 'hidden',
              ]}
            >
              <!-- Blueprint Header Bar: Responsive Adaptive Layout -->
              <div id={`project-${proj.slug}`} class="border-b border-border-architectural bg-surface-card/50 select-none w-full max-w-full">
                <!-- Mobile 3-Tier Stacked Layout (< md) -->
                <div class="md:hidden px-3.5 py-3 space-y-2 font-mono">
                  <!-- Tier 1: Index + Confidentiality / Access Status Badge -->
                  <div class="flex items-center justify-between gap-2 text-[10px] pb-1.5 border-b border-border-architectural/50">
                    <span class="text-accent-primary font-bold">[{String(idx + 1).padStart(2, '0')} // CASE_STUDY]</span>
                    {proj.confidentiality === 'confidential_nda' ? (
                      <Badge variant="outline" text="CONFIDENTIAL (NDA)" class="text-[9px] shrink-0" />
                    ) : (
                      <Badge variant="accent" text="PUBLIC / OPEN" class="text-[9px] shrink-0" />
                    )}
                  </div>

                  <!-- Tier 2: Full Project Title (100% Readable, No Truncation) -->
                  <h3 class="text-sm font-bold text-text-contrast tracking-tight leading-snug">
                    {proj.title}
                  </h3>

                  <!-- Tier 3: Client / Institution & Architecture System Details -->
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-text-dim pt-1 border-t border-border-architectural/40">
                    {proj.organization && (
                      <span class="text-text-muted">
                        CLIENT: <strong class="text-text-contrast font-medium">{proj.organization.name}</strong>
                      </span>
                    )}
                    {proj.architecture_system && (
                      <>
                        <span class="text-border-architectural hidden sm:inline">|</span>
                        <span class="text-accent-primary/90 text-[10px]">
                          SYS: {proj.architecture_system.title}
                        </span>
                      </>
                    )}
                  </div>
                </div>

                <!-- Desktop Single-Row Blueprint Header Bar (md+) -->
                <div class="hidden md:flex px-4 sm:px-6 py-2.5 items-center justify-between gap-3 font-mono text-[10px] text-text-dim">
                  <div class="flex items-center gap-2 min-w-0 flex-1">
                    <span class="text-accent-primary font-bold shrink-0">[{String(idx + 1).padStart(2, '0')} // CASE_STUDY]</span>
                    <span class="text-border-architectural shrink-0">|</span>
                    <span class="text-text-contrast font-semibold uppercase truncate">{proj.title}</span>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    {proj.organization && (
                      <>
                        <span class="whitespace-nowrap">CLIENT: {proj.organization.name}</span>
                        <span class="text-border-architectural">|</span>
                      </>
                    )}
                    {proj.confidentiality === 'confidential_nda' ? (
                      <Badge variant="outline" text="CONFIDENTIAL (NDA)" class="text-[9px] shrink-0 whitespace-nowrap" />
                    ) : (
                      <Badge variant="accent" text="PUBLIC / OPEN" class="text-[9px] shrink-0 whitespace-nowrap" />
                    )}
                  </div>
                </div>
              </div>

              <!-- 7:5 Split Cartesian Chamber -->
              <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-border-architectural items-stretch min-w-0 max-w-full overflow-hidden">
                <!-- Left: Interactive Preview Tabs (7 cols) -->
                <div class="lg:col-span-7 w-full min-w-0 max-w-full p-3 sm:p-6 bg-canvas/40 flex flex-col justify-between overflow-hidden">
                  <ArchitecturalTabs
                    cardId={`tabs-${proj.id}`}
                    labels={{
                      ui: t('tab.uiPreview'),
                      arch: t('tab.architecture'),
                      code: t('tab.codeSnippet'),
                    }}
                    hasArch={Boolean(proj.problem_statement || proj.architecture_system)}
                    hasCode={Boolean(proj.core_code_snippet)}
                  >
                    <!-- Tab Panel 1: UI Preview / Thumbnail -->
                    {proj.thumbnail ? (
                      <div slot="ui" class="relative aspect-video w-full overflow-hidden bg-canvas flex items-center justify-center">
                        {(() => {
                          const optimizedImg = getProjectImage(proj.thumbnail);
                          return optimizedImg ? (
                            <Image
                              src={optimizedImg}
                              alt={proj.title}
                              width={720}
                              height={405}
                              format="webp"
                              quality={80}
                              class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-300"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <img
                              src={proj.thumbnail}
                              alt={proj.title}
                              width="720"
                              height="405"
                              class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-300"
                              loading="lazy"
                              decoding="async"
                            />
                          );
                        })()}
                        <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-canvas/80 backdrop-blur-sm border border-border-architectural text-[10px] font-mono text-text-dim">
                          FORMAT: {proj.media_type.toUpperCase()}
                        </div>
                      </div>
                    ) : (
                      <div slot="ui" class="relative min-h-[280px] sm:min-h-0 sm:aspect-video w-full overflow-hidden bg-canvas border border-border-architectural flex flex-col items-center justify-center p-3 sm:p-6 text-center select-none bg-hatch-45">
                        <!-- Corner Crosshairs (+) -->
                        <svg aria-hidden="true" width="7" height="7" viewBox="0 0 5 5" class="absolute top-2 left-2 fill-accent-primary/60">
                          <path d="M2 0h1v2h2v1h-2v2h-1v-2h-2v-1h2z" />
                        </svg>
                        <svg aria-hidden="true" width="7" height="7" viewBox="0 0 5 5" class="absolute top-2 right-2 fill-accent-primary/60">
                          <path d="M2 0h1v2h2v1h-2v2h-1v-2h-2v-1h2z" />
                        </svg>
                        <svg aria-hidden="true" width="7" height="7" viewBox="0 0 5 5" class="absolute bottom-2 left-2 fill-accent-primary/60">
                          <path d="M2 0h1v2h2v1h-2v2h-1v-2h-2v-1h2z" />
                        </svg>
                        <svg aria-hidden="true" width="7" height="7" viewBox="0 0 5 5" class="absolute bottom-2 right-2 fill-accent-primary/60">
                          <path d="M2 0h1v2h2v1h-2v2h-1v-2h-2v-1h2z" />
                        </svg>

                        <!-- Blueprint Technical Card -->
                        <div class="max-w-md w-full p-4 sm:p-5 rounded border border-border-architectural bg-canvas/95 backdrop-blur-sm shadow-tactile-surface flex flex-col items-center gap-2 sm:gap-2.5">
                          <!-- Status Badge -->
                          <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full animate-pulse bg-amber-400"></span>
                            <span class="font-mono text-[10px] sm:text-[11px] font-bold tracking-wider uppercase text-amber-400">
                              {proj.placeholder_info?.tag ?? '// CREDENTIAL / PHOTO NOT FOUND'}
                            </span>
                          </div>

                          <!-- Icon / Monospace Tag -->
                          <div class="font-mono text-xs sm:text-sm text-text-dim px-2 py-0.5 rounded bg-surface-card border border-border-architectural">
                            {proj.placeholder_info?.icon ?? '// RESTRICTED_ASSET'}
                          </div>

                          <!-- Title -->
                          <div class="font-bold text-xs sm:text-sm text-text-contrast tracking-tight">
                            {proj.placeholder_info ? proj.placeholder_info.title[lang] : (lang === 'id' ? 'Visual Antarmuka Dibatasi' : 'Visual Preview Restricted')}
                          </div>

                          <!-- Note / Description -->
                          <p class="font-mono text-[11px] sm:text-xs text-text-muted leading-relaxed max-w-sm">
                            {proj.placeholder_info ? proj.placeholder_info.description[lang] : (lang === 'id' ? 'Aplikasi ini tidak memiliki foto pratinjau publik atau beroperasi tanpa antarmuka grafis (headless).' : 'This application has no public visual preview or operates as a headless backend system.')}
                          </p>

                          <!-- Bottom System Diagnostic Strip -->
                          <div class="pt-2 border-t border-border-architectural/60 w-full flex items-center justify-between text-[9px] sm:text-[10px] font-mono text-text-dim">
                            <span>SECURITY: RESTRICTED</span>
                            <span class="text-accent-primary">ACTIVE_RUNTIME</span>
                          </div>
                        </div>

                        <!-- Bottom Left Tag -->
                        <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-canvas/90 border border-border-architectural text-[9px] sm:text-[10px] font-mono text-text-dim">
                          PREVIEW: NOT_AVAILABLE
                        </div>
                      </div>
                    )}

                    <!-- Tab Panel 2: Architecture Flow Details -->
                    <div slot="arch" class="p-4 sm:p-5 space-y-3 font-mono text-xs bg-canvas/90 text-text-muted min-h-[220px]">
                      {proj.organization && (
                        <div class="flex items-center justify-between border-b border-border-architectural/60 pb-2">
                          <span class="text-text-dim">// ORGANIZATION</span>
                          <span class="text-text-contrast font-medium">{proj.organization.name}</span>
                        </div>
                      )}

                      {proj.architecture_system && (
                        <div class="flex items-center justify-between border-b border-border-architectural/60 pb-2">
                          <span class="text-text-dim">// SYSTEM PATTERN</span>
                          <span class="text-accent-primary">{proj.architecture_system.title}</span>
                        </div>
                      )}

                      {proj.problem_statement && (
                        <div class="space-y-1 pt-1">
                          <span class="text-accent-primary">// PROBLEM STATEMENT</span>
                          <p class="font-sans text-xs text-text-muted leading-relaxed">
                            {proj.problem_statement[lang]}
                          </p>
                        </div>
                      )}

                      {proj.solution_statement && (
                        <div class="space-y-1 pt-1">
                          <span class="text-text-contrast">// SOLUTION HIGHLIGHT</span>
                          <p class="font-sans text-xs text-text-muted leading-relaxed">
                            {proj.solution_statement[lang]}
                          </p>
                        </div>
                      )}
                    </div>

                    <!-- Tab Panel 3: Core Code Snippet -->
                    <div slot="code" class="p-3 sm:p-4 overflow-x-auto arch-scrollbar bg-canvas/95 font-mono text-[11px] text-text-contrast min-h-[220px] max-h-[340px] w-full max-w-full">
                      <pre class="leading-relaxed w-full max-w-full overflow-x-auto whitespace-pre"><code>{proj.core_code_snippet}</code></pre>
                    </div>
                  </ArchitecturalTabs>
                </div>

                <!-- Right: Metadata, BLUF Narrative & Links (5 cols) -->
                <div class="lg:col-span-5 w-full min-w-0 max-w-full flex flex-col justify-between divide-y divide-border-architectural bg-surface-card/30 overflow-hidden">
                  <div class="p-4 sm:p-6 space-y-4 min-w-0">
                    <!-- Title & Organization (Desktop md+, on mobile displayed in top 3-tier header) -->
                    <div class="hidden md:block">
                      <h3 class="text-lg sm:text-xl font-bold text-text-contrast tracking-tight mb-1">
                        {proj.title}
                      </h3>
                      {proj.organization && (
                        <p class="font-mono text-xs text-text-dim">
                          Client/Institution: {proj.organization.name}
                        </p>
                      )}
                    </div>

                    <!-- BLUF Summary -->
                    <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
                      {proj.summary_bluf[lang]}
                    </p>

                    <!-- Key Metrics (if available) -->
                    {proj.key_metrics && proj.key_metrics.length > 0 && (
                      <div class:list={[
                        'grid divide-x divide-border-architectural border border-border-architectural rounded bg-canvas/40 py-2',
                        proj.key_metrics.length === 2 ? 'grid-cols-2' : 'grid-cols-3',
                      ]}>
                        {proj.key_metrics.map((metric) => (
                          <div class="text-center font-mono px-1 sm:px-2 min-w-0">
                            <div class="text-xs sm:text-sm font-bold text-accent-primary tabular-nums truncate">
                              {metric.value}
                            </div>
                            <div class="text-[9px] sm:text-[10px] text-text-dim truncate">
                              {metric.label[lang]}
                            </div>
                          </div>
                        ))}
                      </div>
                    )}

                    <!-- Technologies Badges -->
                    <div class="space-y-1.5 pt-1">
                      <div class="font-mono text-[11px] text-text-dim uppercase tracking-wider">
                        Technologies Utilized
                      </div>
                      <div class="flex flex-wrap gap-1.5">
                        {proj.technologies.map((tech) => (
                          <Badge variant="default" text={tech.name} />
                        ))}
                      </div>
                    </div>
                  </div>

                  <!-- Dynamic Multi-Link Buttons Bottom Strip -->
                  {proj.links.length > 0 && (
                    <div class="p-3 sm:px-6 sm:py-4 bg-surface-card/70 flex flex-wrap gap-2 min-w-0">
                      {proj.links.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class:list={[
                            'inline-flex items-center gap-1.5 px-3 py-2 sm:px-3 sm:py-1.5 rounded-control text-xs font-mono transition-all active:translate-y-px touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary min-h-[38px] sm:min-h-0 max-w-full',
                            link.is_primary
                              ? 'bg-accent-primary text-canvas font-semibold hover:bg-accent-primary-light shadow-tactile-primary'
                              : 'border border-border-architectural bg-surface-card hover:bg-surface-elevated text-text-contrast shadow-tactile-surface',
                          ]}
                        >
                          <span class="truncate max-w-[240px] sm:max-w-none">{link.title}</span>
                          <span class="text-[11px] shrink-0">↗</span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- ==================================================================== -->
        <!-- BOTTOM FOOTER: Blueprint Spec Summary Bar                            -->
        <!-- ==================================================================== -->
        <div class="px-3 sm:px-6 py-2 border-t border-border-architectural bg-surface-card/60 flex flex-wrap items-center justify-between gap-2 font-mono text-[10px] text-text-dim select-none w-full max-w-full">
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-accent-primary font-bold truncate">// WORKSTATION_SPEC</span>
            <span class="text-border-architectural hidden sm:inline">|</span>
            <span class="hidden sm:inline">SHOWCASE_CONSOLE</span>
          </div>
          <span class="text-[9px] sm:text-[10px] shrink-0">SSG // 100% ZERO-JS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Scoped Interactive Showcase Console Controller (Responsive Hybrid Grid)
  function initProjectShowcase() {
    const section = document.getElementById('project-showcase-console');
    if (!section) return;

    const catButtons = section.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');
    const desktopTabs = section.querySelectorAll<HTMLButtonElement>('.project-selector-tab');
    const mobileKeys = section.querySelectorAll<HTMLButtonElement>('.mobile-keypad-btn');
    const panels = section.querySelectorAll<HTMLElement>('.project-showcase-panel');
    const desktopCounter = section.querySelector<HTMLElement>('.desktop-index-counter');
    const mobileCounter = section.querySelector<HTMLElement>('.mobile-index-counter');
    const prevButtons = section.querySelectorAll<HTMLButtonElement>('.btn-prev-proj');
    const nextButtons = section.querySelectorAll<HTMLButtonElement>('.btn-next-proj');
    const ribbonContainer = section.querySelector<HTMLElement>('#project-ribbon-container');
    const mobileRibbon = section.querySelector<HTMLElement>('#mobile-project-ribbon-container');

    let currentCat = 'all';
    let currentIdx = 0;

    // Get array of valid project indices based on category filter
    function getValidIndices(): number[] {
      const indices: number[] = [];
      panels.forEach((p, idx) => {
        if (currentCat === 'all') {
          indices.push(idx);
        } else {
          const cats = (p.getAttribute('data-categories') || '').split(' ');
          if (cats.includes(currentCat)) {
            indices.push(idx);
          }
        }
      });
      return indices;
    }

    // Activate a project by its index
    function activateProject(idx: number, scrollIntoView: boolean = true) {
      if (idx < 0 || idx >= panels.length) return;
      currentIdx = idx;

      // Update Desktop Tabs
      desktopTabs.forEach((btn, i) => {
        const isTarget = i === idx;
        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
        if (isTarget) {
          btn.classList.add('active-tab', 'bg-surface-elevated', 'text-text-contrast', 'font-semibold', 'border-accent-primary', 'shadow-tactile-primary');
          btn.classList.remove('bg-surface-card/40', 'text-text-muted', 'border-transparent');
        } else {
          btn.classList.remove('active-tab', 'bg-surface-elevated', 'text-text-contrast', 'font-semibold', 'border-accent-primary', 'shadow-tactile-primary');
          btn.classList.add('bg-surface-card/40', 'text-text-muted', 'border-transparent');
        }
      });

      // Update Mobile Keypad Buttons
      mobileKeys.forEach((btn, i) => {
        const isTarget = i === idx;
        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
        if (isTarget) {
          btn.classList.add('active-tab', 'bg-surface-elevated', 'text-accent-primary', 'border-accent-primary', 'shadow-tactile-primary');
          btn.classList.remove('bg-surface-card/40', 'text-text-dim', 'border-transparent');
        } else {
          btn.classList.remove('active-tab', 'bg-surface-elevated', 'text-accent-primary', 'border-accent-primary', 'shadow-tactile-primary');
          btn.classList.add('bg-surface-card/40', 'text-text-dim', 'border-transparent');
        }
      });

      // Smoothly scroll the desktop ribbon container
      if (scrollIntoView && ribbonContainer && desktopTabs[idx]) {
        const targetBtn = desktopTabs[idx];
        const containerWidth = ribbonContainer.clientWidth;
        const btnLeft = targetBtn.offsetLeft;
        const btnWidth = targetBtn.clientWidth;
        const targetScrollLeft = btnLeft - (containerWidth / 2) + (btnWidth / 2);
        ribbonContainer.scrollTo({
          left: Math.max(0, targetScrollLeft),
          behavior: 'smooth',
        });
      }

      // Smoothly scroll the mobile keypad ribbon container
      if (scrollIntoView && mobileRibbon && mobileKeys[idx]) {
        const targetBtn = mobileKeys[idx];
        const containerWidth = mobileRibbon.clientWidth;
        const btnLeft = targetBtn.offsetLeft;
        const btnWidth = targetBtn.clientWidth;
        const targetScrollLeft = btnLeft - (containerWidth / 2) + (btnWidth / 2);
        mobileRibbon.scrollTo({
          left: Math.max(0, targetScrollLeft),
          behavior: 'smooth',
        });
      }

      // Defensive guard against browser viewport horizontal displacement
      if (window.scrollX !== 0) {
        window.scrollTo({ left: 0, top: window.scrollY });
      }

      // Update Panels
      panels.forEach((p, i) => {
        if (i === idx) {
          p.classList.remove('hidden');
          p.classList.add('block');
        } else {
          p.classList.add('hidden');
          p.classList.remove('block');
        }
      });

      // Update Counters
      const validIndices = getValidIndices();
      const pos = validIndices.indexOf(idx);
      const displayPos = pos >= 0 ? pos + 1 : idx + 1;
      const counterStr = `${String(displayPos).padStart(2, '0')} / ${String(validIndices.length).padStart(2, '0')}`;
      if (desktopCounter) desktopCounter.textContent = counterStr;
      if (mobileCounter) mobileCounter.textContent = counterStr;
    }

    // Filter by Category
    function filterCategory(catId: string) {
      currentCat = catId;

      // Update Category Buttons styling
      catButtons.forEach((btn) => {
        const isMatch = btn.getAttribute('data-cat-filter') === catId;
        if (isMatch) {
          btn.classList.add('border-accent-primary', 'bg-surface-elevated', 'text-accent-primary', 'font-semibold', 'shadow-tactile-primary');
          btn.classList.remove('border-border-architectural', 'bg-surface-card', 'text-text-muted');
        } else {
          btn.classList.remove('border-accent-primary', 'bg-surface-elevated', 'text-accent-primary', 'font-semibold', 'shadow-tactile-primary');
          btn.classList.add('border-border-architectural', 'bg-surface-card', 'text-text-muted');
        }
      });

      const validIndices = getValidIndices();

      // Update Desktop tabs visibility
      desktopTabs.forEach((btn, i) => {
        if (validIndices.includes(i)) {
          btn.classList.remove('hidden');
        } else {
          btn.classList.add('hidden');
        }
      });

      // Update Mobile keypad buttons state
      mobileKeys.forEach((btn, i) => {
        if (validIndices.includes(i)) {
          btn.classList.remove('opacity-25', 'pointer-events-none');
        } else {
          btn.classList.add('opacity-25', 'pointer-events-none');
        }
      });

      // Activate first available project in category
      if (validIndices.length > 0) {
        if (!validIndices.includes(currentIdx)) {
          activateProject(validIndices[0], true);
        } else {
          activateProject(currentIdx, true);
        }
      }
    }

    // Event Listeners for Category Buttons
    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat-filter') || 'all';
        filterCategory(cat);
      });
    });

    // Event Listeners for Desktop Tab Buttons
    desktopTabs.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        activateProject(i, false);
      });
    });

    // Event Listeners for Mobile Keypad Buttons
    mobileKeys.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        activateProject(i, false);
      });
    });

    // Prev Navigation
    prevButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const validIndices = getValidIndices();
        if (validIndices.length === 0) return;
        let pos = validIndices.indexOf(currentIdx);
        pos = pos <= 0 ? validIndices.length - 1 : pos - 1;
        activateProject(validIndices[pos], true);
      });
    });

    // Next Navigation
    nextButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const validIndices = getValidIndices();
        if (validIndices.length === 0) return;
        let pos = validIndices.indexOf(currentIdx);
        pos = pos >= validIndices.length - 1 ? 0 : pos + 1;
        activateProject(validIndices[pos], true);
      });
    });

    // Handle deep link hash e.g. #project-kkm-grouping-genetic-algorithm
    function checkHash() {
      const hash = window.location.hash;
      if (hash && hash.startsWith('#project-')) {
        const slug = hash.replace('#project-', '');
        const targetBtn = section?.querySelector<HTMLButtonElement>(`.project-selector-tab[data-slug="${slug}"]`);
        if (targetBtn) {
          const idx = parseInt(targetBtn.getAttribute('data-project-idx') || '0', 10);
          filterCategory('all');
          activateProject(idx, true);
        }
      }
    }

    checkHash();
    window.addEventListener('hashchange', checkHash);
  }

  // Initialize on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectShowcase);
  } else {
    initProjectShowcase();
  }
</script>
