---
import {
  experienceRepository,
  educationRepository,
  certificateRepository,
} from '@/lib/repositories';
import { useTranslations, type SupportedLanguage } from '@/i18n/ui';
import SectionHeading from '../SectionHeading.astro';
import ArchitecturalCard from '../ArchitecturalCard.astro';
import Badge from '../Badge.astro';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const experiences = await experienceRepository.getAllWithRelations();
const educations = await educationRepository.getAllWithRelations();
const certificates = await certificateRepository.getAllWithRelations();

const typeLabels = {
  fulltime: 'FULL-TIME',
  contract: 'CONTRACT',
  freelance: 'FREELANCE',
  internship: 'INTERNSHIP',
  community: 'COMMUNITY',
};
---

<section id="experience" class="py-16 md:py-24 border-b border-border-architectural">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <SectionHeading
      index={t('section.experience.index')}
      title={t('section.experience.title')}
      subtitle={lang === 'id'
        ? 'Rekam jejak kontribusi industri profesional, magang rekayasa perangkat lunak, kepemimpinan komunitas Google Developer Groups, dan almamater akademis.'
        : 'Professional track record spanning software engineering roles, internships, Google Developer Groups community leadership, and academic milestones.'}
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Left Column: Work Experience Timeline (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-accent-primary flex items-center gap-2">
          <span>// PENGALAMAN KERJA & ORGANISASI</span>
          <span class="h-px flex-1 bg-border-architectural"></span>
        </h3>

        <div class="relative border-l border-border-architectural pl-6 ml-3 space-y-8">
          {experiences.map((exp) => (
            <div class="relative group">
              <!-- Timeline Indicator Pin -->
              <div
                class:list={[
                  'absolute -left-[31px] top-1.5 w-3 h-3 rounded-full border bg-canvas transition-colors',
                  exp.is_current
                    ? 'border-accent-primary bg-accent-primary animate-pulse'
                    : 'border-border-architectural group-hover:border-accent-primary',
                ]}
              ></div>

              <div class="space-y-2">
                <!-- Role & Period -->
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h4 class="text-base font-semibold text-text-contrast">
                    {exp.role}
                  </h4>
                  <span class="font-mono text-xs text-text-dim">
                    {exp.period_start} — {exp.period_end ?? (lang === 'id' ? 'Sekarang' : 'Present')}
                  </span>
                </div>

                <!-- Organization & Location -->
                <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
                  <span class="text-accent-primary font-medium">
                    {exp.organization?.name}
                  </span>
                  <span class="text-text-dim">•</span>
                  <span class="text-text-dim">{exp.location}</span>
                  <Badge variant="outline" text={typeLabels[exp.type]} class="ml-1 text-[10px]" />
                </div>

                <!-- Highlights List -->
                <ul class="space-y-1.5 pt-2 text-xs text-text-muted leading-relaxed list-disc list-outside pl-4">
                  {exp.highlights[lang].map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>

                <!-- Technologies Used -->
                {exp.technologies.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-2">
                    {exp.technologies.map((tech) => (
                      <Badge variant="default" text={tech.name} class="text-[10px]" />
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Education & Industry Certifications (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        <!-- Formal Education -->
        <div class="space-y-4">
          <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-accent-primary flex items-center gap-2">
            <span>// PENDIDIKAN FORMAL</span>
            <span class="h-px flex-1 bg-border-architectural"></span>
          </h3>

          <div class="space-y-4">
            {educations.map((edu) => (
              <ArchitecturalCard class="p-5 space-y-2">
                <div class="flex items-center justify-between">
                  <h4 class="text-sm font-semibold text-text-contrast">
                    {edu.degree}
                  </h4>
                  <span class="font-mono text-xs text-text-dim">{edu.period}</span>
                </div>

                <p class="font-mono text-xs text-accent-primary">
                  {edu.organization?.name}
                </p>

                {edu.gpa && (
                  <p class="text-xs text-text-dim">
                    {edu.gpa}
                  </p>
                )}

                {edu.thesis_title && (
                  <div class="pt-2 border-t border-border-architectural/60 space-y-1">
                    <span class="font-mono text-[10px] text-text-dim uppercase tracking-wider">
                      {lang === 'id' ? 'Judul Riset Skripsi:' : 'Bachelor Thesis Topic:'}
                    </span>
                    <p class="text-xs text-text-muted italic leading-relaxed">
                      "{edu.thesis_title}"
                    </p>
                    {edu.thesis_project && (
                      <a
                        href={`#project-${edu.thesis_project.slug}`}
                        class="inline-flex items-center gap-1 font-mono text-[11px] text-accent-primary hover:underline pt-1"
                      >
                        <span>{lang === 'id' ? 'Lihat Studi Kasus Skripsi' : 'View Thesis Project Case Study'}</span>
                        <span>→</span>
                      </a>
                    )}
                  </div>
                )}
              </ArchitecturalCard>
            ))}
          </div>
        </div>

        <!-- Certifications -->
        <div class="space-y-4">
          <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-accent-primary flex items-center gap-2">
            <span>// SERTIFIKASI & PELATIHAN INTENSIF</span>
            <span class="h-px flex-1 bg-border-architectural"></span>
          </h3>

          <div class="space-y-3">
            {certificates.map((cert) => (
              <ArchitecturalCard class="p-4 space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="text-xs font-semibold text-text-contrast leading-snug">
                    {cert.title}
                  </h4>
                  <span class="font-mono text-[11px] text-text-dim shrink-0">
                    {cert.issue_date}
                  </span>
                </div>

                <div class="flex items-center justify-between text-[11px] font-mono">
                  <span class="text-text-muted">{cert.issuer?.name}</span>
                  <span class="text-text-dim">{cert.credential_id}</span>
                </div>

                <div class="flex flex-wrap gap-1 pt-1">
                  {cert.technologies.map((tech) => (
                    <Badge variant="default" text={tech.name} class="text-[10px]" />
                  ))}
                </div>
              </ArchitecturalCard>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
