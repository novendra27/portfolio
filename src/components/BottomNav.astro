---
import { useTranslations, type SupportedLanguage } from '@/i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  {
    hubId: 'hero',
    href: '#hero',
    defaultLabel: t('nav.home'),
    subLabels: {
      'hero': t('nav.home'),
    },
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    hubId: 'architecture',
    href: '#architecture',
    defaultLabel: t('nav.architecture'),
    subLabels: {
      'architecture': t('nav.architecture'),
    },
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>`,
  },
  {
    hubId: 'projects',
    href: '#projects',
    defaultLabel: t('nav.projects'),
    subLabels: {
      'projects': t('nav.projects'),
      'tech-stack': lang === 'id' ? 'Stack' : 'Stack',
    },
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>`,
  },
  {
    hubId: 'experience',
    href: '#experience',
    defaultLabel: t('nav.experience'),
    subLabels: {
      'experience': t('nav.experience'),
      'pricing': lang === 'id' ? 'Layanan' : 'Pricing',
      'publications': lang === 'id' ? 'Publikasi' : 'Research',
    },
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>`,
  },
  {
    hubId: 'contact',
    href: '#contact',
    defaultLabel: t('nav.contact'),
    subLabels: {
      'contact': t('nav.contact'),
    },
    isCta: true,
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
];
---

<nav
  aria-label="Mobile Bottom Navigation"
  class="md:hidden fixed bottom-3 inset-x-3 sm:inset-x-6 z-50 pointer-events-auto"
>
  <div
    class="max-w-md mx-auto bg-surface-card/95 backdrop-blur-md border border-border-architectural rounded-lg p-1.5 shadow-2xl shadow-black/80 flex items-center justify-between gap-1 relative select-none"
  >
    <!-- Architectural Corner Crosshairs (+) -->
    <svg aria-hidden="true" width="7" height="7" viewBox="0 0 5 5" class="absolute -top-1 -left-1 fill-accent-primary/80 pointer-events-none">
      <path d="M2 0h1v2h2v1h-2v2h-1v-2h-2v-1h2z" />
    </svg>
    <svg aria-hidden="true" width="7" height="7" viewBox="0 0 5 5" class="absolute -top-1 -right-1 fill-accent-primary/80 pointer-events-none">
      <path d="M2 0h1v2h2v1h-2v2h-1v-2h-2v-1h2z" />
    </svg>
    <svg aria-hidden="true" width="7" height="7" viewBox="0 0 5 5" class="absolute -bottom-1 -left-1 fill-accent-primary/80 pointer-events-none">
      <path d="M2 0h1v2h2v1h-2v2h-1v-2h-2v-1h2z" />
    </svg>
    <svg aria-hidden="true" width="7" height="7" viewBox="0 0 5 5" class="absolute -bottom-1 -right-1 fill-accent-primary/80 pointer-events-none">
      <path d="M2 0h1v2h2v1h-2v2h-1v-2h-2v-1h2z" />
    </svg>

    {navItems.map((item) => (
      <a
        href={item.href}
        data-bottom-hub={item.hubId}
        data-default-label={item.defaultLabel}
        data-sublabels={JSON.stringify(item.subLabels)}
        class:list={[
          'bottom-nav-link flex-1 flex flex-col items-center justify-center py-1 px-1 rounded min-h-[44px] transition-all touch-manipulation focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-primary active:scale-95 relative',
          item.isCta
            ? 'text-accent-primary hover:bg-accent-primary/10'
            : 'text-text-muted hover:text-text-contrast hover:bg-surface-elevated/60',
        ]}
      >
        <div class="bottom-nav-icon flex items-center justify-center shrink-0 mb-0.5" set:html={item.icon} />
        <span class="bottom-nav-label font-mono text-[9px] font-medium leading-tight truncate transition-all duration-200">
          {item.defaultLabel}
        </span>
        <!-- Contextual sub-section indicator dot -->
        <span class="bottom-nav-dot absolute top-1 right-2 w-1.5 h-1.5 rounded-full bg-accent-primary opacity-0 transition-opacity duration-200" aria-hidden="true"></span>
      </a>
    ))}
  </div>
</nav>
