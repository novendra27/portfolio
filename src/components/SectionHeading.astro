---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  index,
  title,
  subtitle,
  align = 'left',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'mb-8 md:mb-12',
    align === 'center' ? 'text-center mx-auto max-w-2xl' : 'text-left',
    className,
  ]}
>
  <div class="inline-flex items-center gap-2 mb-2">
    <span class="font-mono text-xs font-semibold tracking-wider text-accent-primary">
      {index}
    </span>
    <span class="h-px w-8 bg-border-architectural"></span>
  </div>

  <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-text-contrast">
    {title}
  </h2>

  {subtitle && (
    <p class="mt-2 text-sm md:text-base text-text-muted leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
