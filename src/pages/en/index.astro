---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/ui';

const t = useTranslations('en');
---

<BaseLayout lang="en" title="Adi Novendra Putra | Fullstack Developer & Software Engineer">
  <main class="flex-1 flex flex-col items-center justify-center p-6 text-center max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border-architectural bg-surface-card text-xs text-accent-primary mb-6">
      <span class="w-2 h-2 rounded-full bg-accent-primary animate-pulse"></span>
      <span>{t('hero.badge')}</span>
    </div>

    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-text-contrast mb-4">
      Adi Novendra Putra
    </h1>

    <p class="text-lg md:text-xl text-text-muted mb-8 max-w-2xl">
      Fullstack Developer & Software Engineer specializing in scalable system architecture, event-driven integration, and high-performance engineering.
    </p>

    <div class="flex items-center gap-4">
      <a
        href="/"
        class="px-4 py-2 text-sm rounded-control border border-border-architectural bg-surface-card hover:bg-surface-elevated text-text-contrast transition-colors"
      >
        Beralih ke Bahasa Indonesia (ID)
      </a>
    </div>
  </main>
</BaseLayout>
